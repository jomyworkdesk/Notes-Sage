DECLARE @OldDatabase NVARCHAR(100);
DECLARE @NewDatabase NVARCHAR(100);
DECLARE @TableName NVARCHAR(100);
DECLARE @SQL NVARCHAR(MAX);

-- Declare values
SET @OldDatabase = 'ALRTEST';
SET @NewDatabase = 'ALTREST11NEW';
SET @TableName = 'PAR';

-- Copy only table structure
SET @SQL = '
SELECT *
INTO ' + QUOTENAME(@NewDatabase) + '.dbo.' + QUOTENAME(@TableName) + '
FROM ' + QUOTENAME(@OldDatabase) + '.dbo.' + QUOTENAME(@TableName) + '
WHERE 1 = 0;
';

-- Execute query
EXEC sp_executesql @SQL;
